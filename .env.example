# Free key: https://console.groq.com/keys
# The OpenAI SDK talks to Groq through this base URL.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Free-plan chat models. Swap either id if Groq renames them.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CONDENSE_MODEL=openai/gpt-oss-20b

# Word windows. Kept under all-MiniLM's 256-token limit.
CHUNK_SIZE=140
CHUNK_OVERLAP=30
TOP_K=4
